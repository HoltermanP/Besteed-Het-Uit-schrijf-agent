  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run migrate:deploy:safe && next build",
    "migrate:deploy:safe": "node -e \"if(process.env.DATABASE_URL){require('child_process').execSync('prisma migrate deploy',{stdio:'inherit'})}else{console.log('Geen DATABASE_URL: migraties overgeslagen')}\"",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "lint": "eslint .",
    "start": "next start",
    "preview": "next start",
    "test": "CI=true playwright test",
    "test:ui": "playwright test --ui"
  },
