generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generieke werkruimte-opslag (key-value). Vervangt localStorage in de browser:
// projecten, dossiers, concepten, opmerkingen, bedrijfsconfig en API-config staan
// hier zodat werk apparaat-onafhankelijk bewaard blijft.
model AppState {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model StyleDocument {
  id         String   @id @default(cuid())
  companyId  String   @default("default")
  name       String
  fileName   String
  mimeType   String
  category   String
  promptType String
  content    String    @db.Text
  analysis   String?   @db.Text
  analyzedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId])
}

// Leerpunt uit een afgerond project ("lessons learned"). Wordt bij de evaluatie
// van een afgeronde aanbesteding opgesteld en als input hergebruikt bij nieuwe projecten.
model LessonLearned {
  id             String   @id @default(cuid())
  companyId      String   @default("default")
  projectTitle   String
  buyer          String?
  outcome        String // gewonnen | verloren | ingetrokken | onbekend
  score          Int? // optionele score (bijv. behaalde of geschatte kans 0-100)
  category       String? // thema/tag, bijv. "prijs", "social return", "ICT"
  situation      String   @db.Text // context: wat speelde er in dit project
  lesson         String   @db.Text // het leerpunt zelf
  recommendation String   @db.Text // hoe toe te passen bij een volgend project
  sourceTenderId String? // koppeling naar het bron-dossier/tender
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
}

// Achtergrondopdracht van de schrijfagent. Een stuk schrijven duurt minuten; de opdracht
// draait daarom los van de browserverbinding en houdt hier voortgang, checkpoint en
// resultaat bij. Sluit de gebruiker het tabblad of valt de verbinding weg, dan loopt het
// werk door en staat het resultaat er als hij terugkomt. Het checkpoint (opzet + reeds
// geschreven secties) maakt hervatting mogelijk als een serverfunctie haar tijdslimiet
// bereikt; een volgende run schrijft alleen wat nog ontbreekt.
model WriteJob {
  id          String    @id
  projectId   String
  draftId     String
  draftTitle  String
  stage       String
  // 'schrijven' | 'opmerkingen' | 'verbeterronde' — alleen voor de statusmelding.
  kind        String
  // 'lopend' | 'gereed' | 'mislukt'
  status      String
  message     String    @db.Text
  // De volledige WriteDraftRequest (JSON), nodig om de opdracht te kunnen hervatten.
  request     String    @db.Text
  checkpoint  String?   @db.Text
  partialHtml String?   @db.Text
  resultHtml  String?   @db.Text
  error       String?   @db.Text
  provider    String?
  model       String?
  // Loopt op bij elke voortgangsschrijving; de client haalt alleen nieuwe versies op.
  version     Int       @default(0)
  runs        Int       @default(0)
  origin      String?
  heartbeatAt DateTime
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([projectId, draftId])
  @@index([status, heartbeatAt])
}
